{
  "sourceLanguage" : "en",
  "strings" : {
    "Binary response — use Hex." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respuesta binaria: usa Hex."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réponse binaire — utilisez Hex."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バイナリのレスポンスです。16 進数表示を使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "바이너리 응답입니다. Hex를 사용하십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "二进制响应——请使用十六进制视图。"
          }
        }
      }
    },
    "Could not remove previous Watch storage (%d)." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido eliminar el almacenamiento anterior del Watch (%d)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de supprimer l’ancien stockage de l’Apple Watch (%d)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以前の Watch のストレージを削除できませんでした（%d）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이전 Watch 저장 공간을 제거할 수 없습니다(%d)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法移除之前的手表存储（%d）。"
          }
        }
      }
    },
    "Could not save Watch requests (%d)." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se han podido guardar las solicitudes del Watch (%d)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’enregistrer les requêtes de l’Apple Watch (%d)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch のリクエストを保存できませんでした（%d）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch 요청을 저장할 수 없습니다(%d)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法存储手表请求（%d）。"
          }
        }
      }
    },
    "Enter an HTTP or HTTPS URL without embedded credentials." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce una URL HTTP o HTTPS sin credenciales incrustadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez une URL HTTP ou HTTPS sans identifiants intégrés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資格情報を含まない HTTP または HTTPS の URL を入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자격 증명이 포함되지 않은 HTTP 또는 HTTPS URL을 입력하십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请输入不含内嵌凭据的 HTTP 或 HTTPS URL。"
          }
        }
      }
    },
    "Invalid Watch request. Bodies are limited to 32 KB and timeout to 30 seconds." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicitud del Watch no válida. Los cuerpos están limitados a 32 KB y el tiempo de espera a 30 segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requête Apple Watch non valide. Les corps sont limités à 32 Ko et le délai d’expiration à 30 secondes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch のリクエストが無効です。本文は 32 KB まで、タイムアウトは 30 秒までです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유효하지 않은 Watch 요청입니다. 본문은 32KB, 시간 초과는 30초로 제한됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无效的手表请求。正文限于 32 KB，超时限于 30 秒。"
          }
        }
      }
    },
    "Invalid header." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encabezado no válido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En-tête non valide."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘッダが無効です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유효하지 않은 헤더입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无效的标头。"
          }
        }
      }
    },
    "Save at most 10 requests on Watch." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda como máximo 10 solicitudes en el Watch."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez au maximum 10 requêtes sur l’Apple Watch."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch に保存できるリクエストは 10 件までです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch에는 최대 10개의 요청을 저장할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手表上最多可存储 10 个请求。"
          }
        }
      }
    },
    "The server did not return an HTTP response." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor no ha devuelto una respuesta HTTP."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur n’a pas renvoyé de réponse HTTP."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバから HTTP レスポンスが返されませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버가 HTTP 응답을 반환하지 않았습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器未返回 HTTP 响应。"
          }
        }
      }
    },
    "Unlock your device to load Watch requests." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desbloquea el dispositivo para cargar las solicitudes del Watch."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déverrouillez votre appareil pour charger les requêtes de l’Apple Watch."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch のリクエストを読み込むには、デバイスのロックを解除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch 요청을 불러오려면 기기 잠금을 해제하십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请解锁设备以载入手表请求。"
          }
        }
      }
    },
    "Watch request is too large." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La solicitud del Watch es demasiado grande."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La requête Apple Watch est trop volumineuse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch のリクエストが大きすぎます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch 요청이 너무 큽니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手表请求过大。"
          }
        }
      }
    },
    "Watch requests exceed 60 KB. Remove a request or reduce its body." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las solicitudes del Watch superan los 60 KB. Elimina una solicitud o reduce su cuerpo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les requêtes de l’Apple Watch dépassent 60 Ko. Supprimez une requête ou réduisez son corps."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch のリクエストが 60 KB を超えています。リクエストを削除するか、本文を小さくしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch 요청이 60KB를 초과합니다. 요청을 제거하거나 본문을 줄이십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手表请求超过 60 KB。请移除一个请求或缩小其正文。"
          }
        }
      }
    },
    "Watch responses are limited to 256 KB." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las respuestas del Watch están limitadas a 256 KB."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réponses sur l’Apple Watch sont limitées à 256 Ko."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch のレスポンスは 256 KB までです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch 응답은 256KB로 제한됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手表响应限于 256 KB。"
          }
        }
      }
    },
    "Watch transfer exceeds 60 KB." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La transferencia al Watch supera los 60 KB."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le transfert vers l’Apple Watch dépasse 60 Ko."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch への転送が 60 KB を超えています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch 전송이 60KB를 초과합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手表传输超过 60 KB。"
          }
