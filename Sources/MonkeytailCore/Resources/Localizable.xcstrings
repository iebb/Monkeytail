          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "셸 확장은 지원되지 않습니다. 리터럴 값이나 {{environment_variables}}를 사용하십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
