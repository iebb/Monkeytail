    "— means the transport did not report this phase. Headers are reported by the transport. Bodies are limited to 1 MB here." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "— significa que el transporte no ha informado de esta fase. Los encabezados los informa el transporte. Aquí los cuerpos están limitados a 1 MB."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "— signifie que le transport n’a pas signalé cette phase. Les en-têtes sont fournis par le transport. Les corps sont limités à 1 Mo ici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "— はトランスポートがこのフェーズを報告しなかったことを示します。ヘッダはトランスポートから報告された内容です。ここでの本文は 1 MB までです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "—은 전송 계층이 이 단계를 보고하지 않았음을 의미합니다. 헤더는 전송 계층에서 보고합니다. 여기에서 본문은 1MB로 제한됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“—”表示传输层未报告此阶段。标头由传输层报告。此处正文限于 1 MB。"
          }
        }
      }
    },
