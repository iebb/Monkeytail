    "Your iCloud session changed. Turn sync off and on to use this session." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu sesión de iCloud ha cambiado. Desactiva y vuelve a activar la sincronización para usar esta sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre session iCloud a changé. Désactivez puis réactivez la synchronisation pour utiliser cette session."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud のセッションが変更されました。このセッションを使用するには、同期をオフにしてからオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 세션이 변경되었습니다. 이 세션을 사용하려면 동기화를 껐다가 다시 켜십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 iCloud 会话已更改。请关闭再打开同步以使用此会话。"
          }
        }
      }
    },
    "Your next request starts here" : {
