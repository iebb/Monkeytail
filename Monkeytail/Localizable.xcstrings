    "Unsupported media. Use Hex or save the response." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contenido multimedia no compatible. Usa Hex o guarda la respuesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Média non pris en charge. Utilisez Hex ou enregistrez la réponse."
