          }
        }
      }
    },
    "Works with Google, GitHub, single sign-on and passkeys, and with the account your browser is already signed in to." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funciona con Google, GitHub, inicio de sesión único y llaves de acceso, y con la cuenta con la que ya has iniciado sesión en el navegador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonctionne avec Google, GitHub, l’authentification unique et les clés d’identification, ainsi qu’avec le compte déjà connecté dans votre navigateur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google、GitHub、シングルサインオン、パスキー、およびブラウザですでにサインインしているアカウントで使用できます。"
          }
